          {
            "order_index": 0,
            "he": "נועה קמה בשבע בבוקר.",
            "ru": "Ноа встаёт в семь утра."
          },
          {
            "order_index": 1,
            "he": "היא שותה מים ואוכלת לחם.",
            "ru": "Она пьёт воду и ест хлеб."
          },
          {
            "order_index": 2,
            "he": "אחר כך היא הולכת לבית הספר.",
            "ru": "Затем она идёт в школу."
          },
          {
            "order_index": 3,
            "he": "בכיתה היא יושבת ליד דניאל.",
            "ru": "В классе она сидит рядом с Даниэлем."
          },
          {
            "order_index": 4,
            "he": "המורה כותבת מילה חדשה על הלוח.",
            "ru": "Учительница пишет новое слово на доске."
          },
          {
            "order_index": 5,
            "he": "נועה קוראת את המילה בקול.",
            "ru": "Ноа читает слово вслух."
          },
          {
            "order_index": 6,
            "he": "בהפסקה הילדים משחקים בחצר.",
            "ru": "На перемене дети играют во дворе."
          },
          {
            "order_index": 7,
            "he": "נועה אוכלת תפוח.",
            "ru": "Ноа ест яблоко."
          },
          {
            "order_index": 8,
            "he": "אחרי הלימודים היא חוזרת הביתה.",
            "ru": "После занятий она возвращается домой."
          },
          {
            "order_index": 9,
            "he": "בבית היא מכינה שיעורים.",
            "ru": "Дома она делает уроки."
          },
          {
            "order_index": 10,
            "he": "בערב המשפחה אוכלת יחד.",
            "ru": "Вечером семья ест вместе."
          },
          {
            "order_index": 11,
            "he": "נועה הולכת לישון בעשר.",
            "ru": "Ноа ложится спать в десять."
          }
