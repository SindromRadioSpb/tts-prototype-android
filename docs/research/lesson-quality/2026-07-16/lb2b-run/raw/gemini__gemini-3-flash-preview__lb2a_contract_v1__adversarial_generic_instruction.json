          {
            "order_index": 0,
            "he": "נועה קמה בשבע בבוקר.",
            "ru": "Ноа встаёт в семь утра."
          },
          {
            "order_index": 1,
            "he": "היא שותה מים ואוכלת לחם.",
            "ru": "Она пьёт воду и ест хлеб."
          },
