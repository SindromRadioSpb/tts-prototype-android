          {
            "order_index": 0,
            "he": "הספר הישן נשאר על המדף.",
            "ru": "Старая книга осталась на полке."
          },
          {
            "order_index": 1,
            "he": "הספר סיפר לילד על העיר העתיקה.",
            "ru": "Парикмахер рассказал мальчику о старом городе."
          },
          {
            "order_index": 2,
            "he": "היא שמרה את המכתב במגירה.",
            "ru": "Она сохранила письмо в ящике."
          },
          {
            "order_index": 3,
            "he": "השומר שמר על השער בלילה.",
            "ru": "Охранник сторожил ворота ночью."
          },
          {
            "order_index": 4,
            "he": "הם חזרו מן הדרך לפני החשכה.",
            "ru": "Они вернулись с дороги до темноты."
          },
          {
            "order_index": 5,
            "he": "המורה ביקשה שיחזרו על המשפט.",
            "ru": "Учительница попросила, чтобы они повторили предложение."
          },
          {
            "order_index": 6,
            "he": "פני הילד היו רציניים.",
            "ru": "Лицо ребёнка было серьёзным."
          },
          {
            "order_index": 7,
            "he": "המדריך אמר: פני ימינה.",
            "ru": "Инструктор сказал: поверни направо."
          },
          {
            "order_index": 8,
            "he": "הקהל שמע קול מן החצר.",
            "ru": "Публика услышала голос со двора."
