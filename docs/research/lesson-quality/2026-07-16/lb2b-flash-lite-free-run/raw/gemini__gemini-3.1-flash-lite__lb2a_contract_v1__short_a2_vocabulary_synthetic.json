          {
            "order_index": 13,
            "he": "שכן צעיר עזר לה לשאת אותו.",
            "ru": "Молодой сосед помог ей её нести."
          },
          {
            "order_index": 14,
            "he": "בבית יעל שטפה את הירקות.",
            "ru": "Дома Яэль вымыла овощи."
          },
          {
            "order_index": 15,
            "he": "היא שמרה חלק מהם במקרר.",
            "ru": "Часть из них она положила в холодильник."
