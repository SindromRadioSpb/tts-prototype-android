  "he_note": "[נוסח 'שירים']",
  "ru": "Свинцовые очи [По мотивам 'Песен']",
  "translit": "ʿênê-ʿôp̄ereṯ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43349",
  "text_id": "by-43349",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "К вечеру [версия «Песни»]",
  "translit": "lip̄nôṯ-ʿereḇ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43352",
  "text_id": "by-43352",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Вечерняя [поэтический вариант]",
  "translit": "ʿarbîṯ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43353",
  "text_id": "by-43353",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Сегодня солнце так скромно",
  "translit": "hayyôm haššemeš kōh ṣənûʿâ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43354",
  "text_id": "by-43354",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Уже настало время забыть",
  "translit": "kəḇār higgîʿâ hāʿēṯ liškōaḥ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43355",
  "text_id": "by-43355",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Листопад",
  "translit": "šalleḵeṯ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43356",
  "text_id": "by-43356",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Душа моя пропала",
  "translit": "nap̄šî ʾāḇəḏâ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43360",
  "text_id": "by-43360",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "И его я не знала.",
  "translit": "gam ʾôṯô lōʾ yāḏaʿtî [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43362",
  "text_id": "by-43362",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "У меня не было матери,",
  "translit": "lʾ hāyəṯâ lî ʾēm [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43363",
  "text_id": "by-43363",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "По дороге",
  "translit": "baddereḵ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43366",
  "text_id": "by-43366",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Сосны [по образцу «Стихотворений»]",
  "translit": "ʾŏrānîm [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43369",
  "text_id": "by-43369",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Забытый стих",
  "translit": "ḥărûz niškāḥ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43373",
  "text_id": "by-43373",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Душа моя томилась по стихам,",
  "translit": "nap̄šî kāləṯâ laḥărûzîm [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43376",
  "text_id": "by-43376",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Стихи горьки и надменны [версия «Песен»]",
  "translit": "diḇrê-šîrâ mārîm ûḡəʾēyônîm [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43377",
  "text_id": "by-43377",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "На заре [Из цикла «Песни»]",
  "translit": "baʿălôṯ haššaḥar [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43380",
  "text_id": "by-43380",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "И стала явью фантазия моя.",
  "translit": "wəhāyâ ḏimyônî limṣîʾûṯ [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43384",
  "text_id": "by-43384",
  "row_id": "r0",
  "he_note": "[נוסח 'שירים']",
  "ru": "Верблюды [в стиле 'Стихотворений']",
  "translit": "gəmallîm [nwsḥ 'šyrym']"
 },
 {
  "work_id": "43455",
  "text_id": "by-43455",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "[Уже настало время забыть] [На мотив 'Маленькой чашки']",
  "translit": "[kəḇār bāʾâ hāʿēṯ liškōaḥ] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43456",
  "text_id": "by-43456",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Душа моя жаждет рифм [в стиле 'Маленькой чашки']",
  "translit": "[nap̄šî ḵāləṯâ laḥărûzîm] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43457",
  "text_id": "by-43457",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "[Не было у меня матери] [по мотивам «Маленькой чаши»]",
  "translit": "[lōʾ hāyəṯâ lî ʾēm] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43458",
  "text_id": "by-43458",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Душа моя утеряна, и нет её.",
  "translit": "[nap̄šî ʾāḇəḏâ wəʾênennâ] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43459",
  "text_id": "by-43459",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Листопад [На мотив 'Маленькой чашечки']",
  "translit": "šalleḵeṯ [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43460",
  "text_id": "by-43460",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "[И тебя не знала я] [Вариант «Маленькая чаша»]",
  "translit": "[ḡam ʾôṯəḵā lōʾ yāḏaʿtî] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43461",
  "text_id": "by-43461",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Свинцовые очи",
  "translit": "ʿênê ʿôp̄ereṯ (zemer) [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43462",
  "text_id": "by-43462",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Горькие и гордые стихи. [На мотив 'Маленькой чашки']",
  "translit": "[diḇrê šîrâ mārîm ûḡəʾēyônîm] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43463",
  "text_id": "by-43463",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "К вечеру",
  "translit": "lip̄nôṯ-ʿereḇ [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43464",
  "text_id": "by-43464",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "На заре [на мотив «малая чаша»]",
  "translit": "baʿălôṯ haššaḥar [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43465",
  "text_id": "by-43465",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Вечер",
  "translit": "ʿarbîṯ [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43466",
  "text_id": "by-43466",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Сегодня солнце так скромно,",
  "translit": "[hayyôm haššemeš kōh ṣənûʿâ] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43467",
  "text_id": "by-43467",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Кедры...",
  "translit": "ʾŏrānîm [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43469",
  "text_id": "by-43469",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "В пути",
  "translit": "baddereḵ [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43472",
  "text_id": "by-43472",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Забытый стих [на мотив «Маленькой рюмки»]",
  "translit": "ḥărûz niškāḥ [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43473",
  "text_id": "by-43473",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "[И моё воображение стало явью] [На мотив \"Маленькой чаши\"]",
  "translit": "[wəhāyâ ḏimyônî limṣîʾûṯ] [nwsḥ 'ḵws qṭnh']"
 },
 {
  "work_id": "43474",
  "text_id": "by-43474",
  "row_id": "r0",
  "he_note": "[נוסח 'כוס קטנה']",
  "ru": "Возле дома проходят верблюды (На мотив «Маленькой чашечки»)",
  "translit": "[lip̄nê ḇêṯî ʿôḇərîm gəmallîm] [nwsḥ 'ḵws qṭnh']"
 },
