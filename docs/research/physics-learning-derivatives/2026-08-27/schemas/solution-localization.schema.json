{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics_solution_localization.1.1.0",
  "title": "Physics solution localization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "source_schema_version", "review_status", "entries"],
  "properties": {
    "schema_version": {"const": "physics_solution_localization.1.1.0"},
    "locale": {"const": "ru"},
    "source_schema_version": {"const": "physics_independent_solution_ledger.1.1.0"},
    "review_status": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 74,
      "maxItems": 74,
      "items": {
        "type": "object",
        "required": ["task_number", "model", "derivation", "result"],
        "properties": {
          "task_number": {"type": "string", "pattern": "^[1-9]\\.[0-9]+$"},
          "model": {"type": "string", "minLength": 1},
          "derivation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "result": {"type": "string", "minLength": 1},
          "comparison_note": {"type": "string"}
        }
      }
    }
  }
}
