{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics_answer_ledger.1.0.0",
  "title": "Physics answer ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_slug", "source", "review", "entries"],
  "properties": {
    "schema_version": {"const": "physics_answer_ledger.1.0.0"},
    "corpus_slug": {"const": "physics-year1-problems"},
    "source": {
      "type": "object",
      "required": ["filename", "sha256", "page_count"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_count": {"const": 5}
      }
    },
    "review": {"type": "object"},
    "entries": {
      "type": "array",
      "minItems": 74,
      "maxItems": 74,
      "items": {
        "type": "object",
        "required": ["task_number", "parts"],
        "properties": {
          "task_number": {"type": "string", "pattern": "^[1-9]\\.[0-9]+$"},
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "label": {"type": "string"},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
