      },
      "lines": {
        "ru": [
          "Есть место ещё для одного друга",
          "Лёгкий ветерок, хорошая книга",
          "Книга нас ждёт",
          "Звёзды уже здесь",
          "Ещё один стул для гостей",
          "Как приятно в тени!",
          "Картинка почти готова",
          "Уголок тишины",
          "Кто хочет чаю?",
          "Хвосту тоже нужно место",
          "Сегодня вечером читаем в сукке",
          "Готовы к истории?"
        ],
        "en": [
          "There's room for one more friend",
          "A light breeze, a good book",
          "The book is waiting for us",
          "The stars are already here",
          "One more chair for the guests",
          "What lovely shade!",
          "The picture is almost ready",
          "A quiet corner",
          "Who wants tea?",
          "A tail needs room too",
          "Tonight we're reading in the sukkah",
          "Ready for a story?"
        ],
        "he": [
          "יֵשׁ מָקוֹם לְעוֹד חָבֵר.",
          "רוּחַ קַלָּה, סֵפֶר טוֹב.",
          "הַסֵּפֶר מְחַכֶּה לָנוּ.",
          "הַכּוֹכָבִים כְּבָר כָּאן.",
          "עוֹד כִּסֵּא לָאוֹרְחִים.",
          "אֵיזֶה צֵל נָעִים!",
          "הַתְּמוּנָה כִּמְעַט מוּכָנָה.",
          "פִּנָּה שֶׁל שֶׁקֶט.",
          "מִי רוֹצֶה תֵּה?",
          "גַּם הַזָּנָב צָרִיךְ מָקוֹם.",
          "הַלַּיְלָה קוֹרְאִים בַּסֻּכָּה.",
          "מוּכָנִים לְסִפּוּר?"
