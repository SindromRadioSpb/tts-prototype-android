  "actors": {
    "timsah": {
      "sheet": "timsah",
      "fictional": true,
      "names": {
        "ru": "Тимсах",
        "en": "Timsah",
        "he": "תמסח"
      },
      "lines": {
        "ru": [
          "Я не голосую — я охраняю урну!",
          "Бюллетень без огласовки? Не пропущу!",
          "Выборы выборами, а повторение — по расписанию.",
          "Тихо! Идёт подсчёт… слов в вашей таблице."
        ],
        "en": [
          "I don't vote — I guard the ballot box!",
          "A ballot without niqqud? Not on my watch!",
          "Elections come and go; reviews stay on schedule.",
          "Quiet! Counting… the words in your table."
        ],
        "he": [
          "אני לא מצביע — אני שומר על הקלפי!",
          "פתק בלי ניקוד? לא במשמרת שלי!",
          "בחירות באות והולכות, החזרות לפי הלוח.",
          "שקט! סופרים… את המילים בטבלה שלך."
        ]
      }
    },
